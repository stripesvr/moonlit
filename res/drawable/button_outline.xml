<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_pressed" />
            <stroke android:width="1.0dip" android:color="@color/moon_accent" />
            <corners android:radius="0.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <stroke android:width="1.0dip" android:color="#ff566171" />
            <corners android:radius="0.0dip" />
        </shape>
    </item>
</selector>